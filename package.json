{
  "name": "jev-routing",
  "private": true,
  "type": "module",
  "description": "Next-hop routing eval: bare large language model vs constrained large language model vs TypeSafe Jev.",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "pnpm --filter @jev-routing/cli eval",
    "fixtures:emit": "pnpm --filter @jev-routing/schema emit-fixtures"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
