# TypeSafe AI (Jev). Required for --mode jev
TYPESAFE_API_KEY=

# OpenAI. Required for --mode bare_llm and --mode constrained_llm
OPENAI_API_KEY=

# Optional model pins
OPENAI_MODEL=gpt-4o-mini
TYPESAFE_MODEL=jev-1.13.0

# Fail-closed post-gate (jev mode)
JEV_CONFIDENCE_MIN=0.6
JEV_NOUL_MAX=0.5
JEV_CLARITY_MIN=1
